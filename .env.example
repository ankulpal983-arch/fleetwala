# ============================================================================
# FLEETWALA PRE-PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env.local for local Vite / frontend testing.
# SERVER-ONLY variables must be set in artifacts/api-server/.env (never in frontend).
# ============================================================================

# Local Server Configuration
PORT=3000
BASE_PATH=/

# ----------------------------------------------------------------------------
# 1. Supabase Staging Client Configuration (Browser-Public)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR-STAGING-ANON-KEY

# ----------------------------------------------------------------------------
# 2. Live Integration Mode Gate
# false = Runs in pre-production pilot mode with sample fixtures.
# true  = Queries live Supabase database tables via repository layer.
#         (Fails closed to LiveSetup screen if VITE_SUPABASE_URL is unconfigured).
# ----------------------------------------------------------------------------
VITE_ENABLE_LIVE=false

# ----------------------------------------------------------------------------
# 3. OAuth Callback & Redirect Configuration
# Configure these allowed redirect URIs in Supabase Dashboard -> Auth -> URL Configuration:
# - http://localhost:3000/**
# - http://localhost:5000/**
# - https://staging.fleetwala.com/**
#
# Configure Google Cloud Console Credentials (OAuth 2.0 Web Client):
# - Authorized JavaScript Origins: http://localhost:3000, https://YOUR-STAGING-PROJECT.supabase.co
# - Authorized Redirect URIs: https://YOUR-STAGING-PROJECT.supabase.co/auth/v1/callback
#
# Configure GitHub OAuth App (Developer Settings -> OAuth Apps):
# - Authorization Callback URL: https://YOUR-STAGING-PROJECT.supabase.co/auth/v1/callback
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# 4. SERVER-ONLY SECRETS (DO NOT COMMIT, DO NOT PREFIX WITH VITE_ OR NEXT_PUBLIC_)
# For use by Express api-server or Supabase Edge Functions only:
# ----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR-SERVICE-ROLE-KEY
# PAYMENT_WEBHOOK_SECRET=YOUR-RAZORPAY-OR-CASHFREE-WEBHOOK-SECRET
# SMS_PROVIDER_API_KEY=YOUR-MSG91-AUTH-KEY (Deferred for Pre-Production)
