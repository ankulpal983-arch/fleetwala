# Browser-public configuration only. These are placeholders, NOT credentials.
# Vite replaces NEXT_PUBLIC_* from the original Next.js proposal with VITE_*.

# Local development port and base path (optional, defaults to 3000 and /)
PORT=3000
BASE_PATH=/

# Staging Supabase Configuration
VITE_SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-STAGING-PUBLISHABLE-KEY

# Keep false during pilot preview. Switch to true only after staging DB migrations are applied.
VITE_ENABLE_LIVE=false

# SERVER-ONLY SECRETS (Do NOT commit, do NOT prefix with VITE_ or NEXT_PUBLIC_):
# SUPABASE_SERVICE_ROLE_KEY=...
# PAYMENT_WEBHOOK_SECRET=...
# SMS_PROVIDER_API_KEY=...
